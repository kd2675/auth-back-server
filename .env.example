# Java properties syntax: unquoted values, no export.
# Optional full local JDBC URL, including connection options:
# AUTH_DB_URL=jdbc:mysql://localhost:3306/AUTH?serverTimezone=Asia/Seoul
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
AUTH_MANAGER_SIGNUP_SECRET=
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3005
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_TOKEN_REUSE_GRACE_MS=5000

# Local URLs. Production requires its own public HTTPS origins/URLs and secure cookies.
AUTH_ISSUER=http://localhost:9000
MUSE_FRONT_BASE_URL=http://localhost:3000
ZEROQ_FRONT_BASE_URL=http://localhost:3001
ZEROQ_ADMIN_BASE_URL=http://localhost:3002
SEMO_FRONT_BASE_URL=http://localhost:3003
STOCK_FRONT_BASE_URL=http://localhost:3005

# Local direct mode: Eureka/Discovery off.
# spring.profiles.active=local-direct

# Gateway/Eureka mode.
# spring.profiles.active=local
